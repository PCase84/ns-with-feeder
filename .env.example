# Dexcom (EU) Zugang
DEXCOM_ACCOUNT_NAME=+491234567890
DEXCOM_PASSWORD=YourPasswordHere

# EU Host (funktioniert mit deinem Curl-Flow)
DEXCOM_HOST=shareous1.dexcom.com

# Offizielle AppID, wie im Curl (nicht ändern)
DEXCOM_APPLICATION_ID=d89443d2-327c-4a6f-89e5-496bbb0317db

# Nightscout Ziel (deine laufende Instanz)
NIGHTSCOUT_URL=https://cgm-remote-monitor-latest-ksym.onrender.com

# Dein API_SECRET (Plaintext); wird im Code zu SHA1 gehasht
NIGHTSCOUT_API_SECRET=your_api_secret_here

# Poll-Intervall in Sekunden
POLL_INTERVAL_SECONDS=60

# Wie viele Minuten Historie pro Abruf (max 1440)
DEXCOM_MINUTES=1440

# Max Count (288 ~ 24h in 5-Min-Schritten)
DEXCOM_MAX_COUNT=288
